<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.xenon.refresh-core-test.plist: nightly pg_dump core_dev, then pg_restore
  core_test on the Mac mini.

  This job is HOST-NATIVE, not image-based: it needs pg_dump / pg_restore /
  psql, and the xenon api image ships only libpq5 (no PG client tools). It
  does NOT need a git checkout either. The operator copies the one script to
  /opt/xenon/bin (see "Install").

  What runs:   /opt/xenon/bin/refresh-core-test.sh
               (copy of scripts/infra/refresh-core-test.sh)
  Schedule:    every day 04:00 ET.
  TZ:          launchd StartCalendarInterval uses the SYSTEM time zone
               (want America/New_York; check: sudo systemsetup -gettimezone).
  Lock:        launchd never starts a second instance of a running label.
               The script refuses SRC == DST. For a manual run during the
               scheduled window, wrap it:  lockf -t 0 /tmp/xenon-refresh-core-test.lock <cmd>
  Creds:       PGPASSFILE -> /opt/xenon/.pgpass-refresh (chmod 600, holds the
               xenon_migrator password for host:5432). No password in this file.
               The script does not read /opt/xenon/.env.
  Volumes:     none (host PostgreSQL on localhost:5432).
  Logs:        /var/log/xenon/refresh-core-test.log (script),
               /var/log/xenon/refresh-core-test.stdout.log and .stderr.log (launchd).

  Install (Mac mini):
    mkdir -p /opt/xenon/bin
    cp scripts/infra/refresh-core-test.sh /opt/xenon/bin/ && chmod +x /opt/xenon/bin/refresh-core-test.sh
    /opt/xenon/bin/refresh-core-test.sh (run with the dry-run argument first: dump only, no restore)
    cp deploy/jobs/com.xenon.refresh-core-test.plist ~/Library/LaunchAgents/
    plutil -lint ~/Library/LaunchAgents/com.xenon.refresh-core-test.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.xenon.refresh-core-test.plist
  Re-copy the script after any change to scripts/infra/refresh-core-test.sh.
  Uninstall: launchctl bootout gui/$(id -u)/com.xenon.refresh-core-test
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xenon.refresh-core-test</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/xenon/bin/refresh-core-test.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>PGHOST</key>
    <string>localhost</string>
    <key>PGPORT</key>
    <string>5432</string>
    <key>PGUSER</key>
    <string>xenon_migrator</string>
    <key>PGPASSFILE</key>
    <string>/opt/xenon/.pgpass-refresh</string>
    <key>XENON_REFRESH_SRC</key>
    <string>core_dev</string>
    <key>XENON_REFRESH_DST</key>
    <string>core_test</string>
    <key>XENON_REFRESH_LOG_DIR</key>
    <string>/var/log/xenon</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/var/log/xenon/refresh-core-test.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/xenon/refresh-core-test.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
