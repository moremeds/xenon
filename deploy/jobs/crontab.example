# crontab.example -- cron alternative to the launchd plists in this directory.
# Use ONE scheduler per job, not both.
#
# Install on the Mac mini:  crontab -e   (as the user that runs the docker stack)
# TZ: macOS cron runs in the SYSTEM time zone (want America/New_York;
# check: sudo systemsetup -gettimezone). Do not rely on CRON_TZ.
# Lock: nav-flex-refresh uses a fixed --name, so Docker refuses a duplicate.
#       refresh-core-test uses lockf(1), which ships with macOS.
# Creds: nav-flex-refresh reads /opt/xenon/.env via the api service env_file.
#        refresh-core-test reads PGPASSFILE=/opt/xenon/.pgpass-refresh (chmod 600).
# Logs:  /var/log/xenon/*.cron.log (directory must exist, writable by this user).

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# 17:30 ET daily -- IB Flex NAV refresh, from the deployed api image.
30 17 * * * cd /opt/xenon && docker-compose -f /opt/xenon/compose.yml run --rm -T --no-deps --name xenon-job-nav-flex-refresh --label com.centurylinklabs.watchtower.enable=false api xenon-nav-flex-refresh >> /var/log/xenon/nav-flex-refresh.cron.log 2>&1

# 04:00 ET daily -- core_dev -> core_test mirror (host-native, needs pg_dump).
0 4 * * * PGHOST=localhost PGPORT=5432 PGUSER=xenon_migrator PGPASSFILE=/opt/xenon/.pgpass-refresh XENON_REFRESH_SRC=core_dev XENON_REFRESH_DST=core_test lockf -t 0 /tmp/xenon-refresh-core-test.lock /opt/xenon/bin/refresh-core-test.sh >> /var/log/xenon/refresh-core-test.cron.log 2>&1
