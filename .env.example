# Trading mode — paper (port 4002) or live (port 4001). Default: paper.
# Drives IB Gateway port selection AND the startup account-prefix guard.
# IB_GATEWAY_PORT is no longer consulted; this var is the only switch.
XENON_TRADING_MODE=paper

# Per-mode broker account placeholder. dev.sh exports the right one as
# XENON_BROKER_ACCOUNT before child processes start. ib_sync overrides this
# from managedAccounts()[0] after the IB Gateway connection is established —
# these values exist only to unblock startup imports of AccountScope.
# Paper requires a DU* prefix; live requires a U* (and not DU*) prefix.
XENON_PAPER_ACCOUNT=DU0000000
# XENON_LIVE_ACCOUNT=U1234567

# IB Gateway connection
# IB_GATEWAY_HOST=127.0.0.1            # Default; override only for cloud/VPS fallback
# IB_GATEWAY_MODE=launchd              # "launchd" (default), or "docker"/"cloud" via scripts/infra/docker/

# CTA data
# MENTHORQ_USER=
# MENTHORQ_PASS=

# F3 quote-token signing. Rotate breaks in-flight tokens (~1s outage window).
# Generate with: python3.13 -c "import secrets; print(secrets.token_hex(32))"
XENON_QUOTE_TOKEN_SECRET=

# F4 order store location. Default data/orders.duckdb.
XENON_ORDERS_DB_PATH=

# Postgres connection. DATABASE_URL is the production target (LAN core_dev for
# live; required). DATABASE_URL_PAPER is consulted only by `dev.sh paper` and
# overrides DATABASE_URL for that session — keeps off-LAN paper dev working
# against local Postgres without rewriting .env. Same logic for the *_TEST
# variants used by pytest.
# DATABASE_URL=postgresql+asyncpg://xenon_app:xenon_dev@<lan-host>:5432/core_dev
# DATABASE_URL_TEST=postgresql+asyncpg://xenon_app:xenon_dev@<lan-host>:5432/core_test
# DATABASE_URL_PAPER=postgresql+asyncpg://xenon_app:xenon_dev@127.0.0.1:5432/core_dev
# DATABASE_URL_TEST_PAPER=postgresql+asyncpg://xenon_app:xenon_dev@127.0.0.1:5432/core_test
