# IB Gateway connection
# IB_GATEWAY_HOST=127.0.0.1    # Local Docker (default)
# IB_GATEWAY_HOST=ib-gateway    # Cloud (Tailscale MagicDNS)
# IB_GATEWAY_PORT=4001
# IB_GATEWAY_MODE=docker        # "docker" (default) | "cloud" (remote, no restart) | "launchd"

# CTA data
# MENTHORQ_USER=
# MENTHORQ_PASS=

# F3 quote-token signing. Rotate breaks in-flight tokens (~1s outage window).
# Generate with: python3.13 -c "import secrets; print(secrets.token_hex(32))"
XENON_QUOTE_TOKEN_SECRET=

# F4 order store location. Default data/orders.duckdb.
XENON_ORDERS_DB_PATH=
