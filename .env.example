# IB Gateway connection
# IB_GATEWAY_HOST=127.0.0.1    # Local Docker (default)
# IB_GATEWAY_HOST=ib-gateway    # Cloud (Tailscale MagicDNS)
# IB_GATEWAY_PORT=4001
# IB_GATEWAY_MODE=docker        # "docker" (default) | "cloud" (remote, no restart) | "launchd"

# CTA data
# MENTHORQ_USER=
# MENTHORQ_PASS=

# Massive.com — historical OHLCV
# MASSIVE_API_KEY=

# Cloudflare R2 — historical OHLCV + TA snapshot storage
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=apex-data
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_API_TOKEN=
