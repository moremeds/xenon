# Copy this to .env and fill in values before running the app.
# Example:
#   cp .env.example .env

# Anthropic / Claude API key for the portfolio chat assistant
ANTHROPIC_API_KEY=
CLAUDE_CODE_API_KEY=
CLAUDE_API_KEY=

# Unusual Whales API token — used as a historic-data source by the
# portfolio_performance + portfolio_report CLIs (OHLC + option history).
# Required to render the /performance page; the assistant chat does not
# call UW directly.
UW_TOKEN=

# Optional: Exa API key for ticker-page research enrichment (/api/ticker/info).
# Drop the line if you don't want web research on /[ticker] pages.
EXA_API_KEY=

# Optional: explicit model override
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: explicit API endpoint override
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Optional: websocket URL for the Node realtime price server.
IB_REALTIME_WS_URL=ws://localhost:8765

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up