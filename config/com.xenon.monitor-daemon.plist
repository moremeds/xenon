<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This file is regenerated by scripts/services/setup_monitor_daemon.sh on
  every `install`, with PROJECT_DIR substituted for the current checkout.
  The tree-checked-in version uses __PROJECT_DIR__ as a placeholder and is
  NOT directly loadable — `launchctl load` from this template will fail.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xenon.monitor-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/services/run_monitor_daemon.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/monitor-daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/monitor-daemon.err.log</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
